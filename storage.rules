rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if file is within size limit (e.g. 10MB)
    function isWithinSizeLimit(size) {
      return request.resource.size <= size * 1024 * 1024;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId && isWithinSizeLimit(10);
    }
  }
}
