# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_ALL_APIS: Unified consolidated API key that integrates Vertex, Gemini, and others.
GOOGLE_ALL_APIS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Yoco Billing
VITE_YOCO_PUBLIC_KEY=
YOCO_SECRET_KEY=
YOCO_API_KEY=
YOCO_WEBHOOK_SECRET=

# Google Play Billing (JSON string)
GOOGLE_PLAY_SERVICE_ACCOUNT=


# Google Analytics
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Vertex AI Configuration
# If these are set (along with GOOGLE_APPLICATION_CREDENTIALS for service account JSON),
# the app will route AI requests through Vertex AI instead of the public Gemini API.
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=

# Model Context Protocol (MCP) Edu Hub Configuration (GRADEMASTER007/ai-tutor-mcp-hub)
MCP_GITHUB_TOKEN=
MCP_FILESYSTEM_DIR=./data/filesystem_edu
MCP_MEMORY_DIR=./data/memory_edu
MCP_POSTGRES_DISABLED=true
